<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iiotedge.build</groupId>
        <artifactId>iiotedge-parent</artifactId>
        <version>2025.08.18</version>
        <relativePath/>
    </parent>

    <!-- Required despite the parent's own <repositories> already pointing here -
         a not-yet-resolved parent can't bootstrap its own resolution, only its
         dependencies benefit from its repository list once it's already fetched.
         See platform-build's README for the full explanation. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/iiotedge/platform-build</url>
        </repository>
    </repositories>

    <!-- Publish target: GitHub Packages, this repo -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </snapshotRepository>
    </distributionManagement>

    <groupId>com.iiotedge</groupId>
    <artifactId>iiotedge-audit-starter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>iiotedge-audit-starter</name>
    <description>Shared Audit Logging Library for IIoTEdge Microservices</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
