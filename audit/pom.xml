<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iiotedge.build</groupId>
        <artifactId>iiotedge-parent</artifactId>
        <version>2026.11.18</version>
        <relativePath/>
    </parent>

    <!-- Required despite the parent's own <repositories> already pointing here -
         a not-yet-resolved parent can't bootstrap its own resolution, only its
         dependencies benefit from its repository list once it's already fetched.
         See platform-build's README for the full explanation. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/iiotedge/platform-build</url>
        </repository>
    </repositories>

    <!-- Publish target: GitHub Packages, this repo -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </snapshotRepository>
    </distributionManagement>

    <groupId>com.iiotedge</groupId>
    <artifactId>iiotedge-audit-starter</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>

    <name>iiotedge-audit-starter</name>
    <description>Shared Audit Logging Library for IIoTEdge Microservices</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Boot 4 renamed spring-boot-starter-aop to spring-boot-starter-aspectj. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- The starter, not bare spring-kafka: Boot 4 moved KafkaProperties and the
             Kafka auto-configuration into spring-boot-kafka, which a plain spring-kafka
             dependency no longer brings. This keeps consuming services' own Kafka
             auto-configuration (KafkaTemplate, @KafkaListener) working as it did on
             Boot 3, where spring-kafka on the classpath was enough. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- AuditEvent is written with Spring Kafka's Jackson 2 JsonSerializer, which
             registers JavaTimeModule only when it is on the classpath. Boot 3's
             spring-boot-starter-json brought it transitively; Boot 4's Jackson 3
             starter does not, and without it every Instant timestamp fails to
             serialize (the aspect then logs and drops the event). Declared explicitly
             so the payload format (epoch-second timestamps) is unchanged. -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
    </dependencies>
</project>
