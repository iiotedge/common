<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.iiotedge.build</groupId>
        <artifactId>iiotedge-parent</artifactId>
        <version>2025.08.18</version>
        <relativePath/>
    </parent>

    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/iiotedge/platform-build</url>
        </repository>
    </repositories>

    <!-- Publish target: GitHub Packages, this repo -->
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages (Snapshots)</name>
            <url>https://maven.pkg.github.com/iiotedge/common</url>
        </snapshotRepository>
    </distributionManagement>

    <groupId>com.iiotedge</groupId>
    <artifactId>iiotedge-security-starter</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>iiotedge-security-starter</name>
    <description>Shared Stateless Security, JWT, and RBAC Library for IIoTEdge Microservices</description>

    <!-- No local java.version (was 17 - inconsistent with the rest of the
         platform, now inherited as 21 from the parent) and no local jjwt.version
         (was 0.11.5, an entire major version behind what iiotedge-bom pins and
         auth-service already uses - two different major versions of the same
         library resolving in the same dependency tree is exactly the
         dependencyConvergence failure auth-service's BOM adoption already hit
         once for this exact library). Both now come from iiotedge-bom. -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
